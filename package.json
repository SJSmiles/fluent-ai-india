{
  "name": "fluent-ai",
  "version": "1.0.0",
  "description": "Fluent-AI - AI-Powered Language Learning with OpenAI",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:services",
    "setup:services": "npm run setup:backend && npm run setup:admin && npm run setup:analytics",
    "setup:backend": "cd backend && npm install",
    "setup:admin": "cd admin-panel && npm install",
    "setup:analytics": "cd analytics-api && npm install",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:admin\" \"npm run proxy\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:admin": "cd admin-panel && ng serve --port 4200 --host 0.0.0.0",
    "dev:proxy": "node proxy-server.js",
    "proxy": "node proxy-server.js",
    "start": "npm run dev",
    "start:prod": "concurrently \"npm run start:backend\" \"npm run start:admin\" \"npm run start:analytics\" \"npm run proxy\"",
    "start:backend": "cd backend && npm run start",
    "start:admin": "cd admin-panel && npm run start",
    "start:analytics": "cd analytics-api && npm run start",
    "build": "npm run build:backend && npm run build:admin",
    "build:backend": "cd backend && npm run build",
    "build:admin": "cd admin-panel && npm run build",
    "build:analytics": "cd analytics-api && npm run build",
    "lint": "npm run lint:backend && npm run lint:admin",
    "lint:backend": "cd backend && npm run lint",
    "lint:admin": "cd admin-panel && npm run lint",
    "clean": "rm -rf node_modules backend/node_modules admin-panel/node_modules backend/dist admin-panel/dist",
    "clean:install": "npm run clean && npm install",
    "kill-ports": "npx kill-port 3000 3001 4200"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "kill-port": "^2.0.1"
  },
  "keywords": [
    "language-learning",
    "openai",
    "gpt-4",
    "whisper",
    "conversation-ai",
    "fluency",
    "fastify",
    "angular"
  ],
  "author": "Fluent-AI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@vapi-ai/server-sdk": "^0.10.2",
    "axios": "^1.11.0",
    "node-cron": "^4.2.1"
  }
}
